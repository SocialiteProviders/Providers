{
    "name": "socialiteproviders/providers",
    "description": "Collection of all OAuth2 Providers for Laravel Socialite",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/socialiteproviders/providers/issues",
        "source": "https://github.com/socialiteproviders/providers",
        "docs": "https://socialiteproviders.com"
    },
    "require": {
        "php": "^8.5",
        "league/oauth1-client": "^1.9",
        "socialiteproviders/manager": "^4.4"
    },
    "require-dev": {
        "composer/semver": "^3.0",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "mockery/mockery": "^1.6",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^13.3",
        "spatie/phpunit-snapshot-assertions": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "SocialiteProviders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialiteProviders\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "pint",
        "test": "phpunit",
        "test:ci": "phpunit --coverage-clover build/logs/clover.xml"
    }
}
